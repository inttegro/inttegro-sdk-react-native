{
  "name": "@inttegro/react-native",
  "version": "0.4.0",
  "description": "Native Inttegro payment sheet for GHS checkout and Ghana Mobile Money",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./payment-sheet": {
      "types": "./lib/payment-sheet.d.ts",
      "react-native": "./src/payment-sheet.ts",
      "default": "./lib/payment-sheet.js"
    },
    "./events": {
      "types": "./lib/events.d.ts",
      "react-native": "./src/events.ts",
      "default": "./lib/events.js"
    },
    "./telemetry": {
      "types": "./lib/telemetry.d.ts",
      "react-native": "./src/telemetry.ts",
      "default": "./lib/telemetry.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "react-native": "./src/types.ts",
      "default": "./lib/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "docs": "typedoc",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "inttegro",
    "payments",
    "checkout",
    "fintech",
    "ghana",
    "ghs",
    "mobile-money",
    "payment-sheet",
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inttegro/inttegro-sdk-react-native.git"
  },
  "homepage": "https://react-native.inttegro.dev/",
  "author": "Inttegro Eng <engineering@inttegro.com> (https://inttegro.com)",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.82"
  },
  "devDependencies": {
    "typedoc": "0.28.20",
    "typescript": "^6.0.3"
  },
  "codegenConfig": {
    "name": "InttegroSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.inttegro.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "Inttegro": "InttegroModule"
      }
    }
  }
}
